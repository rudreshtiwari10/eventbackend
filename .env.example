# Copy this file to .env and fill in real values before running the backend.

# MongoDB Atlas connection string (Database -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gayatrimaharas

# Random long string used to sign login tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme

# The very first admin account. Created automatically on first backend startup
# if no admin exists yet. Change the password after first login is not
# supported yet -- for now, just change this and restart if you need to rotate it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Event details (shown on generated tickets)
EVENT_NAME=GAYATRI MAHARAAS
EVENT_DATE_LABEL=24th October
EVENT_VENUE=Samriddhi Lawn, Ledhupur, Balua Road (near Indian Oil petrol pump, opp. Petals Public School)

# The scanner only works for volunteers on this date (server timezone: Asia/Kolkata).
# Format: YYYY-MM-DD
EVENT_DATE=2026-10-24

# Allow the frontend origin to call this API (comma-separated if more than one)
CORS_ORIGINS=http://localhost:5173
